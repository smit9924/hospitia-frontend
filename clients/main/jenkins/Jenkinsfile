        stage('Deploy') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'deploy-ssh',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER',
                    ),
                    string(
                        credentialsId: 'deployment-server-ip',
                        variable: 'DEPLOYMENT_SERVER_PUBLIC_IP'
                    )
                ]) {

                    sh '''
                        set -Eeuo pipefail

                        echo 'Deploying to server...'
                        echo ${SSH_KEY}
                        echo ${SSH_USER}
                        echo ${DEPLOYMENT_SERVER_PUBLIC_IP}
                        echo ${DOCKER_IMAGE}
                        echo ${APPLICATION_NAME}
                        echo 'Summary ended'

                        ssh \
                            -i "${SSH_KEY}" \
                            -o StrictHostKeyChecking=no \
                            "${SSH_USER}@${DEPLOYMENT_SERVER_PUBLIC_IP}" <<EOF

                        docker pull ${DOCKER_IMAGE}:latest

                        docker stop ${APPLICATION_NAME} || true

                        docker rm ${APPLICATION_NAME} || true

                        docker run -d \
                            --name ${APPLICATION_NAME} \
                            --restart unless-stopped \
                            -p 80:8080 \
                            ${DOCKER_IMAGE}:latest

                        docker image prune -f

                        EOF
                    '''
                }
            }
        }

        stage('Build Summary') {

            steps {

                sh '''
                    printf '\n'
                    printf '=========================================\n'
                    printf 'Build Summary\n'
                    printf '=========================================\n'
                    printf 'Application : %s\n' "${APPLICATION_NAME}"
                    printf 'Branch      : %s\n' "${GIT_BRANCH}"
                    printf 'Commit      : %s\n' "${GIT_COMMIT_SHORT}"
                    printf 'Image       : %s\n' "${DOCKER_IMAGE}"
                    printf 'Image Tag   : %s\n' "${DOCKER_IMAGE_TAG}"
                    printf '=========================================\n'
                '''
            }
        }
    }
}